<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <groupId>net.ederus</groupId>
  <artifactId>Calamity</artifactId>
  <version>1.7.6</version>
  <packaging>jar</packaging>
  <name>Calamity</name>
  <description>Calamity: la PARCA, el Eco, la Aduana y las reglas hardcore de los mundos de Lethal World</description>

  <properties>
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    <maven.compiler.release>25</maven.compiler.release>
    <!-- La version de EDM contra la que se compila. Al subir EDM, subirla aqui.
         Desde Calamity 1.7.6 no vale ninguna anterior a 1.74.0 (MobCoins.pagarPorBaja y conBoost). -->
    <edm.version>1.74.0</edm.version>
    <!-- La version de LethalWorld contra la que se compila. Al subir LethalWorld, subirla
         aqui tambien: el jar se busca por su nombre, con la version dentro. -->
    <lethalworld.version>2.0.0</lethalworld.version>
    <!-- Donde estan los jars de terceros (PlaceholderAPI). En el repo es
         ProyectosGit/_toolchain/libs, tres niveles por encima; en un worktree de
         ZakiWorld-wt/<paquete> es uno mas arriba, y eso lo arregla el perfil de abajo. -->
    <toolchain.libs>${project.basedir}/../../../_toolchain/libs</toolchain.libs>
  </properties>

  <profiles>
    <profile>
      <id>worktree</id>
      <activation>
        <file>
          <missing>${basedir}/../../../_toolchain/libs/PlaceholderAPI-2.11.6.jar</missing>
        </file>
      </activation>
      <properties>
        <toolchain.libs>${project.basedir}/../../../../_toolchain/libs</toolchain.libs>
      </properties>
    </profile>
  </profiles>

  <repositories>
    <repository>
      <id>papermc</id>
      <url>https://repo.papermc.io/repository/maven-public/</url>
    </repository>
    <repository>
      <id>jitpack</id>
      <url>https://jitpack.io</url>
    </repository>
  </repositories>

  <dependencies>
    <dependency>
      <groupId>io.papermc.paper</groupId>
      <artifactId>paper-api</artifactId>
      <version>26.1.2.build.74-stable</version>
      <scope>provided</scope>
    </dependency>
    <!-- EDM: de ahi salen los esbirros (anomaly), las MobCoins, Compat, Estilo y la
         Bitacora. Es el propio jar de al lado, como edm-src hace con los jars de
         _toolchain/libs.

         OJO: HAY QUE COMPILAR EDM ANTES QUE ESTO. Si el jar de esa version no esta
         en ../edm-src/target, Maven falla sin explicar gran cosa.

         MythicMobs NO aparece aqui a proposito: no hay jar suyo en _toolchain/libs
         y solo hace falta para una pregunta, que se hace por reflexion en
         PuenteMythicMobs. -->
    <dependency>
      <groupId>net.ederus</groupId>
      <artifactId>EDM</artifactId>
      <version>${edm.version}</version>
      <scope>system</scope>
      <systemPath>${project.basedir}/../edm-src/target/EDM-${edm.version}.jar</systemPath>
    </dependency>
    <!-- LethalWorld: los mundos (LethalWorldPlugin.esMundo) y la Bitacora lethal-world, que
         Calamity comparte en vez de abrir una suya. Tambien es el jar de al lado.

         OJO: HAY QUE COMPILAR LethalWorld ANTES QUE ESTO, y volver a compilarlo cada vez
         que cambie: se enlaza contra el jar de ../lethalworld-src/target, no contra sus
         fuentes. El orden completo:
             cd ../edm-src         ; mvn -o -DskipTests package
             cd ../lethalworld-src ; mvn -o -DskipTests package
             cd ../calamity-src    ; mvn -o -DskipTests package -->
    <dependency>
      <groupId>net.ederus</groupId>
      <artifactId>LethalWorld</artifactId>
      <version>${lethalworld.version}</version>
      <scope>system</scope>
      <systemPath>${project.basedir}/../lethalworld-src/target/LethalWorld-${lethalworld.version}.jar</systemPath>
    </dependency>
    <!-- PlaceholderAPI, para los %lethalworld_...%. Solo lo toca ExpansionLethal, que no se
         carga si el plugin no esta en el servidor (patron de EDM, edm-src/pom.xml). El
         identificador sigue siendo "lethalworld" aunque la expansion la traiga Calamity:
         los scoreboards y menus del servidor ya lo usan. -->
    <dependency>
      <groupId>me.clip</groupId>
      <artifactId>placeholderapi</artifactId>
      <version>2.11.6</version>
      <scope>system</scope>
      <systemPath>${toolchain.libs}/PlaceholderAPI-2.11.6.jar</systemPath>
    </dependency>
    <!-- MMOItems y MythicLib, solo para el Engarzador (EngarceMmo): engarzar y quitar gemas con
         la API de verdad (GemStone.applyOntoItem, MMOItem.removeGemStone), que por reflexion
         seria media API a ciegas. Los mismos jars que usa EDM (edm-src/pom.xml). Siguen siendo
         softdepend: solo EngarceMmo toca sus clases, y nadie la llama sin PuenteMmo.disponible();
         sin MMOItems en el servidor, Calamity arranca igual. -->
    <dependency>
      <groupId>net.Indyuce</groupId>
      <artifactId>MMOItems</artifactId>
      <version>6.10.1</version>
      <scope>system</scope>
      <systemPath>${toolchain.libs}/MMOItems.jar</systemPath>
    </dependency>
    <dependency>
      <groupId>io.lumine</groupId>
      <artifactId>MythicLib</artifactId>
      <version>1.7.1</version>
      <scope>system</scope>
      <systemPath>${toolchain.libs}/MythicLib.jar</systemPath>
    </dependency>
  </dependencies>

  <build>
    <finalName>Calamity-${project.version}</finalName>
    <resources>
      <resource>
        <directory>src/main/resources</directory>
        <filtering>false</filtering>
      </resource>
    </resources>
  </build>
</project>
